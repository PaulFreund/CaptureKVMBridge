# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration
#
CONFIG_TINYUSB_MODE_DMA=y
CONFIG_TINYUSB_DEBUG_LEVEL=0
# CONFIG_TINYUSB_CDC_ENABLED is not set
CONFIG_TINYUSB_CDC_COUNT=0
CONFIG_TINYUSB_HID_COUNT=2
CONFIG_UAC_MIC_CHANNEL_NUM=1
CONFIG_UAC_SAMPLE_RATE=48000
CONFIG_UAC_MIC_INTERVAL_MS=10
CONFIG_UAC_SPK_INTERVAL_MS=10
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_UAC_SPEAKER_CHANNEL_NUM=0
CONFIG_UAC_SPK_TASK_PRIORITY=5
CONFIG_UAC_SPK_TASK_CORE=-1
CONFIG_UART_ISR_IN_IRAM=y
CONFIG_APP_ENABLE_USB_AUDIO=y
CONFIG_APP_ENABLE_USB_HID=y
# CONFIG_APP_ENABLE_USB_SERIAL_JTAG_TLV is not set
CONFIG_APP_ABS_MOUSE_MAX_X=32768
CONFIG_APP_ABS_MOUSE_MAX_Y=32768
CONFIG_APP_BOARD_RGB_LED_GPIO=48
CONFIG_APP_BOARD_RGB_LED_PULSE_MS=120
CONFIG_USB_DEVICE_UAC_AS_PART=y
CONFIG_APP_UART_BAUDRATE=6000000
CONFIG_APP_UART_PORT_NUM=0
CONFIG_APP_UART_RX_GPIO=44
CONFIG_APP_UART_TX_GPIO=-1
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
# CONFIG_ESP_CONSOLE_UART_CUSTOM is not set
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y

# Serial flasher config
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
